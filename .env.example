# ---------------------------------------------------------------------------
# BANCO DE DADOS
# ---------------------------------------------------------------------------
# String de conexão do PostgreSQL.
# Local com Docker: postgresql://postgres:postgres@localhost:5432/botloja
#
# Supabase (recomendado usar os dois):
#   DATABASE_URL = connection pooler (porta 6543, "?pgbouncer=true") — é o
#     que o app usa em runtime; funciona em ambientes serverless (Vercel)
#     que só falam IPv4, diferente da conexão direta do Supabase (IPv6-only
#     sem o add-on pago).
#   DIRECT_URL = conexão direta (porta 5432) — usada só pelo Prisma CLI
#     para rodar migrations.
# Neon/Railway: normalmente uma única DATABASE_URL já basta (copie a que o
#   provedor fornecer); pode repetir o mesmo valor em DIRECT_URL.
DATABASE_URL="postgresql://user:password@host:6543/botloja?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/botloja"

# ---------------------------------------------------------------------------
# AUTENTICAÇÃO (Auth.js) - painel administrativo
# ---------------------------------------------------------------------------
# Gere um valor aleatório com: npx auth secret
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# URL PÚBLICA DO APP - usada para montar links de imagem (QR Code do PIX)
# que a Meta/Twilio conseguem baixar. Sem isso, a imagem do QR é pulada no
# envio real (o link "copia e cola" e o texto continuam funcionando normal).
# ---------------------------------------------------------------------------
APP_URL="" # ex: https://seuapp.vercel.app (sem barra no final)

# ---------------------------------------------------------------------------
# WHATSAPP - deixe em branco para usar o modo mock. "meta" = API oficial
# direto; "twilio" = via Twilio (BSP), alternativa que não exige CNPJ/
# verificação de empresa para testar (veja services/whatsapp/twilio-provider.ts)
# ---------------------------------------------------------------------------
WHATSAPP_PROVIDER="mock" # "mock" | "meta" | "twilio"

# --- Meta Cloud API (WHATSAPP_PROVIDER="meta") ---
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="" # usado no handshake de configuração do webhook (GET)
WHATSAPP_APP_SECRET="" # usado para validar a assinatura das mensagens recebidas (POST)

# --- Twilio (WHATSAPP_PROVIDER="twilio") ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_NUMBER="" # ex: "whatsapp:+14155238886" (número do Sandbox)

# ---------------------------------------------------------------------------
# PAGAMENTO (PIX) - deixe em branco para usar o modo mock
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER="mock" # "mock" | "mercadopago" | "efi" | "asaas" | "pagbank"
PAYMENT_API_KEY=""
PAYMENT_SECRET=""
WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# IA / NLU - deixe em branco para usar o modo mock (regras locais)
# ---------------------------------------------------------------------------
AI_PROVIDER="mock" # "mock" | "openai"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
